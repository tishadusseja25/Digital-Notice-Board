{
  "name": "digital-notice-board",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed": "tsx --env-file=.env scripts/seed-admin.ts",
    "cleanup": "tsx --env-file=.env scripts/cleanup.ts",
    "e2e": "npm run build && playwright test",
    "seed:demo": "tsx --env-file=.env scripts/seed-demo.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.65.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
